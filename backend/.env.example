# Neon PostgreSQL connection (pooled — for runtime queries)
DATABASE_URL=postgresql://USER:PASS@ep-your-pooler-host.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon direct connection (non-pooled — for Prisma migrations)
DIRECT_URL=postgresql://USER:PASS@ep-your-direct-host.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT
JWT_SECRET=replace_this_with_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_this_with_another_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development
